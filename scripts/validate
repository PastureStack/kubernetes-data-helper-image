#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

test -f Dockerfile
test -f LICENSE
test -f COMPATIBILITY.md
test -f ORIGIN.md
python3 .github/scripts/test_runtime_vulnerability_policy.py
test "$(sed -n 's/^ARG IMAGE_VERSION=//p' Dockerfile)" = v0.1.4
grep -Fq 'ADD --checksum=sha256:5b6326f1932cfd7be57130561dc78192f09ed9f58bfbe6606ed0c50510c3b6cd' Dockerfile
grep -Fq 'https://archive.ubuntu.com/ubuntu/pool/main/c/ca-certificates/ca-certificates_20260816ubuntu0.26.04.1_all.deb' Dockerfile
sh -n scripts/install-ubuntu-security-updates.sh
grep -Fq 'sh /tmp/install-ubuntu-security-updates.sh' Dockerfile
grep -Fq 'libssl3t64=3.5.5-1ubuntu3.7' ubuntu-security-packages.lock
if grep -Fq 'dpkg -i /tmp/ca-certificates.deb' Dockerfile; then
    echo 'Do not add a CA package or TLS executable to the minimal runtime' >&2
    exit 1
fi
grep -Fq 'USER 65532:65532' Dockerfile
grep -Fq 'ENTRYPOINT ["/bin/true"]' Dockerfile
grep -Fq 'rm -f /usr/bin/pebble' Dockerfile
grep -Fq 'org.opencontainers.image.source="https://github.com/PastureStack/kubernetes-data-helper-image"' Dockerfile

if grep -E -n 'v[0-9]+\.[0-9]+\.[0-9]+-[A-Za-z]' Dockerfile README.md COMPATIBILITY.md; then
    echo 'Current product coordinates must use pure numeric semantic versions' >&2
    exit 1
fi

while IFS= read -r action_line; do
    if ! printf '%s\n' "$action_line" | grep -Eq '@[0-9a-f]{40}([[:space:]]+#.*)?[[:space:]]*$'; then
        printf 'GitHub Action is not pinned to a full commit SHA: %s\n' "$action_line" >&2
        exit 1
    fi
done < <(grep -R -h -E '^[[:space:]]+uses:' .github/workflows)

if grep -R -E -l --exclude-dir=.git -- 'BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY' .; then
    echo 'Rejected private key material in committed source' >&2
    exit 1
fi

echo 'KUBERNETES_DATA_HELPER_VALIDATE_OK version=v0.1.4'
